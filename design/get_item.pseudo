# Project One Get-Item Pseudocode

START get_item

    OUTPUT "Enter an item to get using: get item name"
    INPUT item_command

    SET requested_item = item named in item_command

    IF requested_item is the item in current_room
        ADD requested_item to inventory
        OUTPUT requested_item + " retrieved!"
    ELSE
        OUTPUT "Can't get " + requested_item + "!"

    RETURN to game loop

END get_item
