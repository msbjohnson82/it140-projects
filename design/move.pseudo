# Project One Move-Between-Rooms Pseudocode

SET current_room = Foyer

WHILE game is not over

    OUTPUT "You are in the " + current_room
    OUTPUT "Enter a move: go North, go South, go East, or go West"
    INPUT direction

    IF direction is a valid direction from current_room
        SET current_room = room in that direction
        OUTPUT "You moved to the " + current_room
    ELSE
        OUTPUT "You can't go that way!"

END WHILE
